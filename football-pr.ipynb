"""
International football match predictor.
Predicts home win / draw / away win probabilities with a small keras model,
and compares it against a few simple baselines.
"""
import os

import numpy as np
import pandas as pd
from sklearn.metrics import log_loss
from sklearn.preprocessing import StandardScaler
from tensorflow import keras

# ---------------------------------------------------------------------------
# settings
# ---------------------------------------------------------------------------
BASE_DIR = r"C:\Users\Nitro\Downloads"
RESULTS_FILE = os.path.join(BASE_DIR, "results.csv")
FORMER_NAMES_FILE = os.path.join(BASE_DIR, "former_names.csv")

WINDOW = 5                    # how many past matches count as "recent form"
TRAIN_END = "2016-01-01"      # train = everything before this
VAL_END = "2020-01-01"        # val = 2016-2019, test = 2020 onwards
ELO_START, ELO_K, ELO_HOME_ADV = 1500, 30, 100

FORM_COLS = ["form_win", "form_draw", "form_loss", "form_gf", "form_ga"]
# what to use when a team has no previous matches yet
FORM_PRIOR = {"form_win": 1 / 3, "form_draw": 1 / 3, "form_loss": 1 / 3,
              "form_gf": 1.3, "form_ga": 1.3}

FEATURES = (
    [f"h_{c}" for c in FORM_COLS]
    + [f"a_{c}" for c in FORM_COLS]
    + ["h_elo", "a_elo", "elo_diff", "neutral"]
)

# ---------------------------------------------------------------------------
# load data, fix old team names, sort by date
# ---------------------------------------------------------------------------
results = pd.read_csv(RESULTS_FILE, parse_dates=["date"])
former = pd.read_csv(FORMER_NAMES_FILE, parse_dates=["start_date", "end_date"])

required = ["date", "home_team", "away_team", "home_score", "away_score", "neutral"]
missing = [c for c in required if c not in results.columns]
if missing:
    raise ValueError(f"Missing columns in results.csv: {missing}")

results = results.dropna(subset=["home_score", "away_score"]).copy()

# only rename a team inside the dates it actually used the old name
for _, r in former.iterrows():
    in_range = (results["date"] >= r["start_date"]) & (results["date"] <= r["end_date"])
    for col in ["home_team", "away_team"]:
        results.loc[in_range & (results[col] == r["former"]), col] = r["current"]

# the csv isn't guaranteed to be in order, and everything below depends on it
results = results.sort_values("date", kind="stable").reset_index(drop=True)
results["match_id"] = results.index
results["neutral"] = results["neutral"].astype(bool)

# 0 = home win, 1 = draw, 2 = away win
results["match_result"] = np.select(
    [results["home_score"] > results["away_score"],
     results["home_score"] == results["away_score"]],
    [0, 1], default=2,
)

# ---------------------------------------------------------------------------
# recent form per team
# ---------------------------------------------------------------------------
# one row per team per match, so a team's home and away games count together
def side_frame(df, side):
    own, opp = ("home", "away") if side == "home" else ("away", "home")
    return pd.DataFrame({
        "match_id": df["match_id"],
        "date": df["date"],
        "team": df[f"{own}_team"],
        "gf": df[f"{own}_score"],
        "ga": df[f"{opp}_score"],
        "side": side,
    })

long = pd.concat([side_frame(results, "home"), side_frame(results, "away")])
long = long.sort_values(["date", "match_id"], kind="stable").reset_index(drop=True)
long["form_win"] = (long["gf"] > long["ga"]).astype(float)
long["form_draw"] = (long["gf"] == long["ga"]).astype(float)
long["form_loss"] = (long["gf"] < long["ga"]).astype(float)
long["form_gf"] = long["gf"].astype(float)
long["form_ga"] = long["ga"].astype(float)

# keep an unshifted copy, predict_match needs the latest real form
raw_form = long[["team"] + FORM_COLS].copy()

grp = long.groupby("team")
for c in FORM_COLS:
    # shift(1) is the important bit: without it the current match leaks
    # into its own features
    long[c] = grp[c].transform(lambda s: s.shift(1).rolling(WINDOW, min_periods=1).mean())
    long[c] = long[c].fillna(FORM_PRIOR[c])

home_feats = long[long["side"] == "home"].set_index("match_id")[FORM_COLS].add_prefix("h_")
away_feats = long[long["side"] == "away"].set_index("match_id")[FORM_COLS].add_prefix("a_")
results = results.join(home_feats, on="match_id").join(away_feats, on="match_id")

# ---------------------------------------------------------------------------
# elo ratings
# ---------------------------------------------------------------------------
# store the rating before the match, then update it with the result
ratings = {}
h_elo, a_elo = [], []
for row in results.itertuples(index=False):
    rh = ratings.get(row.home_team, ELO_START)
    ra = ratings.get(row.away_team, ELO_START)
    h_elo.append(rh)
    a_elo.append(ra)

    adv = 0 if row.neutral else ELO_HOME_ADV
    expected_home = 1 / (1 + 10 ** ((ra - (rh + adv)) / 400))
    actual_home = 1.0 if row.match_result == 0 else (0.5 if row.match_result == 1 else 0.0)
    delta = ELO_K * (actual_home - expected_home)
    ratings[row.home_team] = rh + delta
    ratings[row.away_team] = ra - delta

results["h_elo"] = h_elo
results["a_elo"] = a_elo
results["elo_diff"] = results["h_elo"] - results["a_elo"]
final_ratings = dict(ratings)  # ratings after the last match, used for predictions

# ---------------------------------------------------------------------------
# split by date (no shuffling, we're predicting the future)
# ---------------------------------------------------------------------------
train = results[results["date"] < TRAIN_END]
val = results[(results["date"] >= TRAIN_END) & (results["date"] < VAL_END)]
test = results[results["date"] >= VAL_END]
print(f"train={len(train)}  val={len(val)}  test={len(test)}")

# team ids come from the training set only, 0 is for teams we haven't seen
train_teams = pd.concat([train["home_team"], train["away_team"]]).unique()
team_map = {name: i + 1 for i, name in enumerate(train_teams)}
num_teams = len(team_map) + 1

# scaler only sees the training data
scaler = StandardScaler().fit(train[FEATURES].astype(float))


def make_inputs(df):
    return {
        "home_team": df["home_team"].map(team_map).fillna(0).astype(int).to_numpy(),
        "away_team": df["away_team"].map(team_map).fillna(0).astype(int).to_numpy(),
        "numeric_features": scaler.transform(df[FEATURES].astype(float)),
    }


def make_labels(df):
    return keras.utils.to_categorical(df["match_result"], num_classes=3)


X_train, y_train = make_inputs(train), make_labels(train)
X_val, y_val = make_inputs(val), make_labels(val)
X_test, y_test = make_inputs(test), make_labels(test)

# ---------------------------------------------------------------------------
# model
# ---------------------------------------------------------------------------
home_in = keras.layers.Input(shape=(1,), name="home_team")
away_in = keras.layers.Input(shape=(1,), name="away_team")
num_in = keras.layers.Input(shape=(len(FEATURES),), name="numeric_features")

emb_size = min(16, max(4, int(np.sqrt(num_teams))))
# one embedding layer shared by both sides, so a team means the same thing
# whether it's home or away
team_embedding = keras.layers.Embedding(num_teams, emb_size, name="team_embedding")

home_vec = keras.layers.Flatten()(team_embedding(home_in))
away_vec = keras.layers.Flatten()(team_embedding(away_in))

x = keras.layers.Concatenate()([home_vec, away_vec, num_in])
x = keras.layers.Dense(128, activation="swish", kernel_regularizer=keras.regularizers.l2(1e-4))(x)
x = keras.layers.Dropout(0.3)(x)
x = keras.layers.Dense(64, activation="swish", kernel_regularizer=keras.regularizers.l2(1e-4))(x)
x = keras.layers.Dropout(0.3)(x)
x = keras.layers.Dense(32, activation="swish")(x)
out = keras.layers.Dense(3, activation="softmax", name="match_result")(x)

model = keras.Model([home_in, away_in, num_in], out)
model.compile(optimizer=keras.optimizers.Adam(1e-3),
              loss="categorical_crossentropy", metrics=["accuracy"])

# stop when val loss stops improving instead of guessing an epoch count
early_stop = keras.callbacks.EarlyStopping(
    monitor="val_loss", patience=5, restore_best_weights=True)

model.fit(X_train, y_train, validation_data=(X_val, y_val),
          epochs=100, batch_size=64, callbacks=[early_stop], verbose=1)

# ---------------------------------------------------------------------------
# test set results (the model never touched these matches)
# ---------------------------------------------------------------------------
test_probs = model.predict(X_test, verbose=0)
test_pred = test_probs.argmax(axis=1)
test_true = test["match_result"].to_numpy()

majority_class = train["match_result"].mode()[0]
print(f"\nTest accuracy:            {(test_pred == test_true).mean():.4f}")
print(f"Test log-loss:            {log_loss(test_true, test_probs, labels=[0, 1, 2]):.4f}")
print(f"Baseline (always class {majority_class}): {(test_true == majority_class).mean():.4f}")

# ---------------------------------------------------------------------------
# is the network actually better than something simple?
# ---------------------------------------------------------------------------
from sklearn.linear_model import LogisticRegression


def elo_features(df):
    # elo gap with home advantage added in. the abs() lets the draw chance
    # drop when the matchup is lopsided
    d = (df["elo_diff"] + np.where(df["neutral"], 0, ELO_HOME_ADV)) / 400.0
    return np.column_stack([d, np.abs(d)])


# same probabilities for every match, just the class frequencies from train
prior = np.bincount(train["match_result"], minlength=3) / len(train)
p_prior = np.tile(prior, (len(test), 1))

# elo gap -> home/draw/away probabilities
elo_clf = LogisticRegression(max_iter=1000).fit(elo_features(train), train["match_result"])
p_elo = elo_clf.predict_proba(elo_features(test))

# logistic regression on the same features the network gets
lr_clf = LogisticRegression(max_iter=2000).fit(X_train["numeric_features"], train["match_result"])
p_lr = lr_clf.predict_proba(X_test["numeric_features"])

p_nn = test_probs

models = {"Prior (class freq)": p_prior, "Elo probability": p_elo,
          "Logistic regression": p_lr, "Neural network": p_nn}

print("\n=== Model comparison on the same test matches ===")
print(f"{'model':<22}{'accuracy':>10}{'log-loss':>10}{'brier':>9}{'mean P(draw)':>14}{'draw top-pick':>15}")
for name, p in models.items():
    acc = (p.argmax(axis=1) == test_true).mean()
    ll = log_loss(test_true, p, labels=[0, 1, 2])
    brier = np.mean(np.sum((p - y_test) ** 2, axis=1))
    print(f"{name:<22}{acc:>10.4f}{ll:>10.4f}{brier:>9.4f}"
          f"{p[:, 1].mean():>14.3f}{(p.argmax(axis=1) == 1).sum():>15d}")
print(f"{'Actual draw rate':<22}{'':>10}{'':>10}{'':>9}{(test_true == 1).mean():>14.3f}")


def per_match_loss(p):
    return -np.log(np.clip(p[np.arange(len(test_true)), test_true], 1e-12, None))


# bootstrap the log-loss difference to see if the gap is real or just noise
rng = np.random.default_rng(42)
loss_nn = per_match_loss(p_nn)
for other in ["Elo probability", "Logistic regression"]:
    diff = loss_nn - per_match_loss(models[other])   # negative means the network wins
    boots = [rng.choice(diff, size=len(diff), replace=True).mean() for _ in range(2000)]
    lo, hi = np.percentile(boots, [2.5, 97.5])
    print(f"NN minus {other}: mean log-loss diff {diff.mean():+.4f}  95% CI [{lo:+.4f}, {hi:+.4f}]")
print("(CI fully below 0 = network really is better, crossing 0 = no real difference)")

# ---------------------------------------------------------------------------
# predicting a new match
# ---------------------------------------------------------------------------
# average of each team's last few matches, same as the training features
current_form = (raw_form.groupby("team").tail(WINDOW)
                .groupby("team")[FORM_COLS].mean())


def predict_match(home_team_name, away_team_name, neutral=False):
    for name in (home_team_name, away_team_name):
        if name not in current_form.index:
            print(f"Error: unknown team - {name}")
            return

    hf, af = current_form.loc[home_team_name], current_form.loc[away_team_name]
    h_r = final_ratings.get(home_team_name, ELO_START)
    a_r = final_ratings.get(away_team_name, ELO_START)

    row = {f"h_{c}": hf[c] for c in FORM_COLS}
    row.update({f"a_{c}": af[c] for c in FORM_COLS})
    row.update({"h_elo": h_r, "a_elo": a_r, "elo_diff": h_r - a_r, "neutral": float(neutral)})

    x_num = scaler.transform(pd.DataFrame([row])[FEATURES].astype(float))
    probs = model.predict({
        "home_team": np.array([team_map.get(home_team_name, 0)]),
        "away_team": np.array([team_map.get(away_team_name, 0)]),
        "numeric_features": x_num,
    }, verbose=0)[0]

    print(f"{home_team_name} win: {probs[0] * 100:.2f}%")
    print(f"Draw:           {probs[1] * 100:.2f}%")
    print(f"{away_team_name} win: {probs[2] * 100:.2f}%")


predict_match("Germany", "France", neutral=False)
